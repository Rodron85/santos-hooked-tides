// Santos Hooked Tides – served by the Cloudflare Worker "santos-hooked-tides"
// Secret needed in Cloudflare (Settings → Variables and Secrets): ADMIRALTY_KEY
{
  "name": "santos-hooked-tides",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // online copy of the catch log and My spots (lib/sync.js); SQLite Durable Objects work on the free plan
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "LogVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LogVault"] }]
}
